<Page
    x:Class="Bloom.App.Views.ServersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Bloom.App.Views"
    Background="{StaticResource BloomBgBrush}">

    <ScrollViewer Style="{StaticResource PageScrollStyle}">
        <StackPanel MaxWidth="960" HorizontalAlignment="Stretch">
            <TextBlock x:Uid="ServersTitle" Text="Server" Style="{StaticResource PageTitleTextStyle}" />

            <!-- Current server -->
            <TextBlock x:Uid="ServerCurrentSection" Text="Aktueller Server" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,8" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="ServerNotInGame" Text="Gerade in keinem Spiel. Die Erkennung braucht die Spielerkennung unter „Roblox-Client“." Style="{StaticResource MutedTextStyle}"
                               Visibility="{x:Bind ViewModel.NotInGame, Mode=OneWay}" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="16" RowSpacing="6" Visibility="{x:Bind ViewModel.InGame, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock x:Uid="ServerGame" Text="Spiel" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.GameName, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" />
                        <TextBlock Grid.Row="1" x:Uid="ServerIdLabel" Text="Server-ID" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.ServerId, Mode=OneWay}" FontFamily="{StaticResource BloomBrandFont}" FontSize="12" IsTextSelectionEnabled="True" />
                        <TextBlock Grid.Row="2" x:Uid="ServerAddressLabel" Text="Adresse" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.Address, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" IsTextSelectionEnabled="True" />
                        <TextBlock Grid.Row="3" x:Uid="ServerLocationLabel" Text="Standort" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.LocationText, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" />
                        <TextBlock Grid.Row="4" Text="Ping" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.PingText, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="ServerRejoin" Content="Gleichem Server erneut beitreten" Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.RejoinCommand}" IsEnabled="{x:Bind ViewModel.InGame, Mode=OneWay}" />
                        <Button x:Uid="ServerNew" Content="Anderer Server" Command="{x:Bind ViewModel.NewServerCommand}" IsEnabled="{x:Bind ViewModel.InGame, Mode=OneWay}" />
                        <Button x:Uid="ServerCopyLink" Content="Link kopieren" Command="{x:Bind ViewModel.CopyLinkCommand}" IsEnabled="{x:Bind ViewModel.InGame, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
                    <ToggleSwitch x:Uid="ServerGeolocation" Header="Server-Standort anzeigen" IsOn="{x:Bind ViewModel.Geolocation, Mode=TwoWay}" />
                    <TextBlock x:Uid="ServerGeolocationHint" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"
                               Text="Dafür wird die Server-Adresse an ipinfo.io geschickt. Der Standort ist ungefähr. Rejoin schließt Roblox kurz und startet es neu." />
                </StackPanel>
            </Border>

            <!-- Browser -->
            <TextBlock x:Uid="ServerBrowserSection" Text="Server-Browser (experimentell)" Style="{StaticResource SectionTitleTextStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Uid="ServerBrowserPlace" PlaceholderText="Roblox-Link oder Place-ID" Text="{x:Bind ViewModel.PlaceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}">
                            <ComboBoxItem x:Uid="ServerSortFewest" Content="Wenigste Spieler zuerst" />
                            <ComboBoxItem x:Uid="ServerSortMost" Content="Meiste Spieler zuerst" />
                        </ComboBox>
                        <Button Grid.Column="2" x:Uid="ServerBrowserLoad" Content="Server laden" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.LoadCommand}" />
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.BrowserStatus, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Servers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:ServerRow">
                                <Grid Padding="0,6" ColumnSpacing="16" BorderBrush="{StaticResource BloomBorderBrush}" BorderThickness="0,1,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Players}" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" />
                                    <ProgressBar Grid.Column="1" Value="{x:Bind Fill}" Maximum="100" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Ping}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Fps}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                                    <Button Grid.Column="4" x:Uid="ServerJoin" Content="Beitreten" Tag="{x:Bind}" Click="OnJoin" HorizontalAlignment="Stretch"
                                            IsEnabled="{x:Bind CanJoin}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Uid="ServerBrowserMore" Content="Mehr laden" Command="{x:Bind ViewModel.MoreCommand}" Visibility="{x:Bind ViewModel.HasMore, Mode=OneWay}" />
                    <TextBlock x:Uid="ServerBrowserHint" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"
                               Text="Ping und FPS meldet der jeweilige Server selbst. Die Server-Liste stammt aus einer nicht offiziell dokumentierten Roblox-Schnittstelle und kann jederzeit ausfallen." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
