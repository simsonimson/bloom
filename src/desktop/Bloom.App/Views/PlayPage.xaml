<Page
    x:Class="Bloom.App.Views.PlayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BloomBgBrush}">
    <ScrollViewer Style="{StaticResource PageScrollStyle}">
        <StackPanel MaxWidth="960" HorizontalAlignment="Stretch">
            <TextBlock x:Uid="PlayTitle" Text="Spielen" Style="{StaticResource PageTitleTextStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <TextBlock x:Uid="PlayPlaceholder" Text="Favoriten, zuletzt gespielte Experiences und Roblox-Links kommen in Phase 2." Style="{StaticResource MutedTextStyle}" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
