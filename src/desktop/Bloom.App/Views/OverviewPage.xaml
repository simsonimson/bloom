<Page
    x:Class="Bloom.App.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Bloom.App.Views"
    Background="{StaticResource BloomBgBrush}">

    <ScrollViewer Style="{StaticResource PageScrollStyle}">
        <StackPanel MaxWidth="960" HorizontalAlignment="Stretch">
            <TextBlock x:Uid="OverviewTitle" Text="Übersicht" Style="{StaticResource PageTitleTextStyle}" FontSize="28" />

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource BloomTextMutedBrush}" />
                        <Ellipse Width="8" Height="8" Fill="{StaticResource BloomSuccessBrush}" Visibility="{x:Bind ViewModel.RobloxRunning, Mode=OneWay}" />
                    </Grid>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Uid="OverviewRoblox" Text="Roblox" Style="{StaticResource BodyTextStyle}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{x:Bind ViewModel.RobloxStatus, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" Foreground="{StaticResource BloomTextMutedBrush}" />

                    <Grid Grid.Row="1" Grid.Column="0" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource BloomTextMutedBrush}" />
                        <Ellipse Width="8" Height="8" Fill="{StaticResource BloomSuccessBrush}" Visibility="{x:Bind ViewModel.PttLive, Mode=OneWay}" />
                    </Grid>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Uid="OverviewPtt" Text="Push-to-Talk" Style="{StaticResource BodyTextStyle}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{x:Bind ViewModel.PttStatus, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" Foreground="{StaticResource BloomTextMutedBrush}" />

                    <Grid Grid.Row="2" Grid.Column="0" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource BloomTextMutedBrush}" />
                        <Ellipse Width="8" Height="8" Fill="{StaticResource BloomSuccessBrush}" Visibility="{x:Bind ViewModel.DiscordConnected, Mode=OneWay}" />
                    </Grid>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Uid="OverviewDiscord" Text="Discord" Style="{StaticResource BodyTextStyle}" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{x:Bind ViewModel.DiscordStatus, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" Foreground="{StaticResource BloomTextMutedBrush}" />

                    <Grid Grid.Row="3" Grid.Column="0" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource BloomTextMutedBrush}" />
                        <Ellipse Width="8" Height="8" Fill="{StaticResource BloomSuccessBrush}" Visibility="{x:Bind ViewModel.AccountConnected, Mode=OneWay}" />
                    </Grid>
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Uid="OverviewAccount" Text="Roblox-Konto" Style="{StaticResource BodyTextStyle}" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="{x:Bind ViewModel.AccountStatus, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" Foreground="{StaticResource BloomTextMutedBrush}" />
                </Grid>
            </Border>

            <TextBlock x:Uid="OverviewQuickLaunch" Text="Schnellstart" Style="{StaticResource SectionTitleTextStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <TextBlock x:Uid="OverviewQuickLaunchEmpty" Text="Noch keine Favoriten. Füge sie unter „Spielen“ hinzu."
                               Style="{StaticResource MutedTextStyle}" Visibility="{x:Bind ViewModel.HasNoQuickLaunch, Mode=OneWay}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.QuickLaunch}" Visibility="{x:Bind ViewModel.HasQuickLaunch, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="12" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:FavoriteItem">
                                <Button Tag="{x:Bind}" Click="OnLaunchFavorite" Padding="8" Width="168" HorizontalContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Border Width="36" Height="36" CornerRadius="6" Background="{StaticResource BloomSurfaceRaisedBrush}">
                                            <Image Source="{x:Bind Icon}" Stretch="UniformToFill" />
                                        </Border>
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" MaxWidth="100" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <TextBlock x:Uid="OverviewActivity" Text="Letzte Aktivität" Style="{StaticResource SectionTitleTextStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <TextBlock x:Uid="OverviewActivityEmpty" Text="Noch keine Aktivität." Style="{StaticResource MutedTextStyle}"
                               Visibility="{x:Bind ViewModel.HasNoRecent, Mode=OneWay}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Recent}" Visibility="{x:Bind ViewModel.HasRecent, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:RecentItem">
                                <Grid Padding="0,6" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyTextStyle}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Subtitle}" Style="{StaticResource MutedTextStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
